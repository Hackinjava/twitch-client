{
  "manifest_version": 3,
  "name": "Twitch Client Simulator",
  "version": "1.0",
  "description": "Twitch client with follower counter, chat spam, and fake donation features. Activates only on Twitch channels.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitch Client Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
